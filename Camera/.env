# ============================================================
# Camera/.env — Docker Compose environment variables
# docker-compose automatically reads this file
# ============================================================

# RTSP server ports
RTSP_PORT=8554
HLS_PORT=8888

# Camera stream sources (override per deployment)
CAM1_VIDEO_FILE=/videos/crowd_peace.mp4
CAM1_RTSP_URL=rtsp://rtsp_server:8554/cam1

CAM2_VIDEO_FILE=/videos/peace_crowd.mp4
CAM2_RTSP_URL=rtsp://rtsp_server:8554/cam2

CAM3_VIDEO_FILE=/videos/crowd_peace.mp4
CAM3_RTSP_URL=rtsp://rtsp_server:8554/cam3

CAM4_VIDEO_FILE=/videos/peace_crowd.mp4
CAM4_RTSP_URL=rtsp://rtsp_server:8554/cam4
